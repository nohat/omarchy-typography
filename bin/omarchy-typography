#!/bin/bash
# omarchy-typography: reversible UI/monospace font-role separation for Omarchy 4.
#
# Roles
#   UI    Proportional. Drives the Omarchy shell (bar, launcher/menu, panels, OSD,
#         dialogs) through this plugin's service, GTK's interface font, Hyprland's
#         window titles and, if you opt in, notification text.
#   Mono  Monospace. Drives terminals and the fontconfig `monospace` alias through
#         Omarchy's own `omarchy-font-set`, and GTK's monospace font.
#
# Every file this tool writes is listed by `omarchy-typography files`.
# `stock` restores the stock look; `uninstall` restores the captured baseline.

set -uo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"   # the plugin folder
DATA="${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-typography"           # baseline, venv
PRESETS="$ROOT/share/presets.json"
BASELINE="$DATA/baseline"
SHIM_DIR="$ROOT/shim"          # no-op omarchy-restart-shell
QUIET_DIR="$ROOT/shim-quiet"   # notification shim, silent only with OMARCHY_TYPOGRAPHY_QUIET=1
FONT_DIR="$HOME/.local/share/fonts/omarchy-typography"
CFG_DIR="$HOME/.config/omarchy/typography"
STATE="$CFG_DIR/state.json"
SUBS="$CFG_DIR/substitutions.json"
FC_CONF="$HOME/.config/fontconfig/conf.d/60-omarchy-typography.conf"
FONTS_CONF="$HOME/.config/fontconfig/fonts.conf"
HYPR_FILE="$HOME/.config/hypr/typography.lua"
HYPR_MAIN="$HOME/.config/hypr/hyprland.lua"
MENU_EXT="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"
HOOK="$HOME/.config/omarchy/hooks/font-set.d/omarchy-typography"
UPDATE_HOOK="$HOME/.config/omarchy/hooks/post-update.d/omarchy-typography"
PLUGIN_ID="$(jq -r .id "$ROOT/manifest.json")"
PLUGIN_DIR="$ROOT"
BIN_LINK="$HOME/.local/bin/omarchy-typography"
NOTIFY_CLONE="$HOME/.config/omarchy/plugins/${USER:-$(id -un)}.notifications"
MARK_BEGIN="omarchy-typography >>>"
MARK_END="<<< omarchy-typography"

die() { echo "omarchy-typography: $*" >&2; exit 1; }
say() { [[ ${QUIET:-0} == 1 ]] || echo "$*"; }

# ------------------------------------------------------------------ fonts

_families_cache=""
installed_families() {
  [[ -n $_families_cache ]] || _families_cache=$(fc-list : family | tr ',' '\n' | sed 's/^ *//;s/ *$//' | sort -u)
  printf '%s\n' "$_families_cache"
}
family_installed() { installed_families | grep -Fxq -- "$1"; }

# First installed name from a JSON array of candidate family names.
resolve_candidates() {
  local name
  while IFS= read -r name; do
    [[ -n $name ]] || continue
    if family_installed "$name"; then printf '%s' "$name"; return 0; fi
  done < <(jq -r '.[]?' <<<"$1")
  return 1
}

baseline_get() { jq -r "$1" "$BASELINE/manifest.json"; }
stock_mono() { baseline_get '.omarchy_font_current'; }

gtk_size() { sed -E 's/.* ([0-9.]+)$/\1/' <<<"$1"; }

# Explicit, user-declared substitution for a missing commercial family.
substitution_for() { # preset role
  [[ -f $SUBS ]] || return 1
  local v; v=$(jq -r --arg p "$1" --arg r "$2" '.[$p][$r] // empty' "$SUBS")
  [[ -n $v ]] && printf '%s' "$v"
}

# Resolve a preset to TSV: id, name, ui, mono, status, detail
resolve_preset() {
  local id=$1 p ui mono status="available" detail="" sub
  p=$(jq -c --arg id "$id" '.presets[] | select(.id == $id or (.name|ascii_downcase) == ($id|ascii_downcase))' "$PRESETS")
  [[ -n $p ]] || return 1
  id=$(jq -r .id <<<"$p")
  local name; name=$(jq -r .name <<<"$p")
  if [[ $id == stock ]]; then printf '%s\x1f%s\x1f\x1f\x1favailable\x1f\n' "$id" "$name"; return 0; fi
  local role cand want missing=()
  for role in ui mono; do
    cand=$(jq -c ".$role" <<<"$p")
    want=$(jq -r ".$role[0]" <<<"$p")
    local got=""
    if got=$(resolve_candidates "$cand"); then :;
    elif sub=$(substitution_for "$id" "$role") && family_installed "$sub"; then
      got=$sub; detail+="${role^^} substitute: $sub for $want. "
    else
      missing+=("$want")
    fi
    [[ $role == ui ]] && ui=$got || mono=$got
  done
  if (( ${#missing[@]} )); then
    status="unavailable"
    local m; for m in "${missing[@]}"; do
      detail+="$m not installed — $(jq -r --arg f "$m" '.licensing[$f] // "install the font, then re-run"' "$PRESETS") "
    done
  elif [[ $detail == *substitute* ]]; then status="substituted"; fi
  printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\n' "$id" "$name" "$ui" "$mono" "$status" "${detail% }"
}

shell_family_for() { # Tabular derivative if one was built for this UI family.
  if family_installed "$1 Tabular"; then printf '%s Tabular' "$1"; else printf '%s' "$1"; fi
}

# ------------------------------------------------------------------ state

state_get() { [[ -f $STATE ]] && jq -r "$1 // empty" "$STATE" 2>/dev/null; }
current_preset() { local p; p=$(state_get .preset); printf '%s' "${p:-stock}"; }

write_state() { # preset ui mono
  mkdir -p "$CFG_DIR"
  local json
  if [[ $1 == stock ]]; then
    json=$(jq -n --arg t "$(date -Iseconds)" '{version:1, preset:"stock", updated:$t}')
  else
    local sf tab=false; sf=$(shell_family_for "$2"); [[ $sf == *" Tabular" ]] && tab=true
    json=$(jq -n --arg p "$1" --arg u "$2" --arg m "$3" --arg s "$sf" --argjson tab $tab --arg t "$(date -Iseconds)" \
      '{version:1, preset:$p, ui:$u, mono:$m, shellFamily:$s, tabularFigures:$tab, updated:$t}')
  fi
  # Written in place (not renamed over) so the shell's file watcher keeps its watch.
  printf '%s\n' "$json" >"$STATE"
}

# ------------------------------------------------------------------ appliers

apply_mono() { # family; uses Omarchy's own font-set so terminals are edited exactly as stock does
  local fam=$1 restart=${2:-0}
  if [[ $(omarchy-font-current) == "$fam" && -f $FONTS_CONF ]]; then return 0; fi
  if (( restart )); then
    PATH="$QUIET_DIR:$PATH" omarchy-font-set "$fam" >/dev/null
  else
    # The shell draws with the UI family, not the monospace alias, so the shell
    # restart omarchy-font-set performs is unnecessary here; the shim skips it.
    PATH="$SHIM_DIR:$QUIET_DIR:$PATH" omarchy-font-set "$fam" >/dev/null
  fi
}

apply_gtk() { # ui mono  (empty = baseline)
  local base_ui base_mono; base_ui=$(baseline_get '.gsettings["font-name"]'); base_mono=$(baseline_get '.gsettings["monospace-font-name"]')
  if [[ -z $1 ]]; then
    gsettings set org.gnome.desktop.interface font-name "$base_ui"
    gsettings set org.gnome.desktop.interface monospace-font-name "$base_mono"
  else
    gsettings set org.gnome.desktop.interface font-name "$1 $(gtk_size "$base_ui")"
    gsettings set org.gnome.desktop.interface monospace-font-name "$2 $(gtk_size "$base_mono")"
  fi
}

apply_hypr() { # ui (empty = remove)
  local before=""; [[ -f $HYPR_FILE ]] && before=$(cat "$HYPR_FILE")
  if [[ -z $1 ]]; then
    rm -f "$HYPR_FILE"
  else
    local q=${1//\"/}
    cat >"$HYPR_FILE" <<LUA
-- Generated by omarchy-typography: window titles use the UI font.
-- Removed by \`omarchy-typography stock\`; do not edit by hand.
hl.config({ group = { groupbar = { font_family = "$q", font_weight_active = "bold" } } })
if hl.plugin and hl.plugin.hyprbars then
  hl.config({ plugin = { hyprbars = { bar_text_font = "$q" } } })
end
LUA
  fi
  local after=""; [[ -f $HYPR_FILE ]] && after=$(cat "$HYPR_FILE")
  if [[ $before != "$after" ]]; then
    hyprctl reload >/dev/null 2>&1
    local errs; errs=$(hyprctl configerrors 2>/dev/null | grep -v '^$' || true)
    [[ -z $errs || $errs == *"no errors"* ]] || echo "warning: Hyprland config errors: $errs" >&2
  fi
}

shell_running() { OMARCHY_SHELL_IPC_TIMEOUT=0.5s omarchy-shell shell ping >/dev/null 2>&1; }

apply_pair() { # id ui mono
  local id=$1 ui=$2 mono=$3
  family_installed "$ui"   || die "UI font '$ui' is not installed (check: fc-list : family | grep -i '$ui')"
  family_installed "$mono" || die "Monospace font '$mono' is not installed"
  fc-list ":family=$mono:spacing=100" family | grep -q . || fc-list ":family=$mono:spacing=90" family | grep -q . \
    || die "'$mono' is not a monospaced family according to fontconfig; refusing to use it as the monospace role"
  write_state "$id" "$ui" "$mono"         # first, so the font-set hook sees the new pairing
  apply_mono "$mono" 0
  apply_gtk "$ui" "$mono"
  apply_hypr "$ui"
  say "Typography: $(jq -r --arg id "$id" '(.presets[] | select(.id==$id) | .name) // "Custom"' "$PRESETS") — UI $ui (shell: $(shell_family_for "$ui")), mono $mono"
}

apply_stock() {
  local had_conf=0; [[ -f $FONTS_CONF ]] && had_conf=1
  write_state stock
  apply_gtk "" ""
  apply_hypr ""
  if (( had_conf )) || [[ $(omarchy-font-current) != "$(stock_mono)" ]]; then
    # Stock shell text follows the monospace alias, which Qt resolved at shell
    # start, so this one transition does restart the shell (as `omarchy font set` would).
    PATH="$QUIET_DIR:$PATH" omarchy-font-set "$(stock_mono)" >/dev/null
    rm -f "$FONTS_CONF"
    fc-cache -f >/dev/null 2>&1
  fi
  restore_terminal_files
  say "Typography: Original Omarchy"
}

# Terminal configs: put back the baseline copy when the only differences are
# the font lines this tool (via omarchy-font-set) changed. Anything else the
# user edited meanwhile is preserved and reported instead.
font_line_re='family|font|font-family|font_family'
restore_terminal_files() {
  local rel cur base
  for rel in alacritty/alacritty.toml foot/foot.ini ghostty/config kitty/kitty.conf; do
    cur="$HOME/.config/$rel"; base="$BASELINE/files/.config/$rel"
    [[ -f $base && -f $cur ]] || continue
    cmp -s "$cur" "$base" && continue
    # omarchy-font-set appends "\nfont_family …" to a kitty.conf whose font line is
    # commented out, so blank lines are ignored along with font lines.
    if diff <(grep -Ev "$font_line_re|^[[:space:]]*$" "$cur") <(grep -Ev "$font_line_re|^[[:space:]]*$" "$base") >/dev/null; then
      cp "$base" "$cur"; chmod u+w "$cur"
    else
      echo "note: $rel has other edits since the baseline; left as is (font lines restored by omarchy-font-set)." >&2
    fi
  done
}

# ------------------------------------------------------------------ commands

cmd_list() {
  local json=0; [[ ${1:-} == --json ]] && json=1
  local cur; cur=$(current_preset)
  local rows; rows=$(jq -r '.presets[].id' "$PRESETS" | while read -r id; do resolve_preset "$id"; done)
  if (( json )); then
    jq -R -s --arg cur "$cur" --slurpfile pr "$PRESETS" '
      ($pr[0]) as $P |
      split("\n") | map(select(length>0) | split("\u001f")) |
      map({id:.[0], name:.[1], ui:.[2], mono:.[3], status:.[4], detail:.[5],
           commercial: (.[0] as $i | ($P.presets[] | select(.id==$i) | .commercial) // false),
           requested: (.[0] as $i | ($P.presets[] | select(.id==$i) | {ui:(.ui[0]? // null), mono:(.mono[0]? // null)})),
           note: (.[2] as $u | $P.notes[$u] // null),
           active: (.[0] == $cur)})' <<<"$rows" | jq --arg cur "$cur" \
      --argjson st "$( [[ -f $STATE ]] && cat "$STATE" || echo '{"preset":"stock"}')" \
      '{active:$cur, state:$st, presets:.}' | jq --argjson fam "$(cmd_families --json)" '. + {families:$fam}'
    return
  fi
  while IFS=$'\x1f' read -r id name ui mono status detail; do
    local mark=" "; [[ $id == "$cur" ]] && mark="●"
    if [[ $id == stock ]]; then printf '%s %-26s %s\n' "$mark" "$name" "stock shell + terminal fonts"
    elif [[ $status == unavailable ]]; then printf '%s %-26s %-34s %s\n' "$mark" "$name" "(unavailable)" "$detail"
    else printf '%s %-26s %-18s + %-16s %s\n' "$mark" "$name" "$ui" "$mono" "${detail}"; fi
  done <<<"$rows"
  if [[ $cur == custom ]]; then echo "● Custom                     $(state_get .ui) + $(state_get .mono)"; fi
  return 0
}

cmd_families() { # --json: proportional and monospace families, minus icon/emoji/derived fonts
  local mono prop
  mono=$(fc-list :spacing=100 family; fc-list :spacing=90 family)
  mono=$(tr ',' '\n' <<<"$mono" | sed 's/^ *//' | grep -v -i -E 'emoji|symbols|nerd font|omarchy|signwriting' | sort -u)
  # Noto ships one family per script ("Noto Sans Arabic"); offer only the Latin umbrella families.
  prop=$(fc-list :lang=en family | tr ',' '\n' | sed 's/^ *//' | grep -v -i -E 'emoji|symbol|nerd|omarchy|mono|tabular|^Noto [A-Za-z]+ .+' | sort -u)
  # keep proportional list to families whose primary face is not monospaced
  prop=$(comm -23 <(printf '%s\n' "$prop") <(printf '%s\n' "$mono"))
  # drop width/weight sub-families that fontconfig reports as separate names ("Poppins Light")
  prop=$(grep -v -E ' (Thin|ExtraLight|Light|Medium|SemiBold|Bold|ExtraBold|Black|Condensed|Narrow)$' <<<"$prop")
  mono=$(grep -v -E ' (Thin|ExtraLight|Light|Medium|SemiBold|Bold|ExtraBold|Black)$' <<<"$mono")
  if [[ ${1:-} == --json ]]; then
    jq -n --arg u "$prop" --arg m "$mono" '{ui:($u|split("\n")|map(select(length>0))), mono:($m|split("\n")|map(select(length>0)))}'
  else
    echo "UI (proportional):"; sed 's/^/  /' <<<"$prop"; echo "Monospace:"; sed 's/^/  /' <<<"$mono"
  fi
}

cmd_status() {
  local cur; cur=$(current_preset)
  echo "Preset:       $(jq -r --arg id "$cur" '(.presets[] | select(.id==$id) | .name) // "Custom"' "$PRESETS")"
  if [[ $cur != stock ]]; then
    echo "UI font:      $(state_get .ui)   (shell draws with: $(state_get .shellFamily))"
    echo "Mono font:    $(state_get .mono)"
  fi
  echo "monospace →   $(fc-match monospace -f '%{family[0]}')"
  echo "GTK UI/mono:  $(gsettings get org.gnome.desktop.interface font-name) / $(gsettings get org.gnome.desktop.interface monospace-font-name)"
  echo "Hyprland:     $([[ -f $HYPR_FILE ]] && echo "titles in $(sed -n 's/.*font_family = "\([^"]*\)".*/\1/p' "$HYPR_FILE")" || echo "stock (monospace)")"
  echo "Shell plugin: $(omarchy plugin list 2>/dev/null | grep -q "$PLUGIN_ID" && echo installed || echo missing)"
}

cmd_set() {
  local key=${1:-}; [[ -n $key ]] || die "usage: omarchy-typography set <preset-id|name>"
  local row; row=$(resolve_preset "$key") || die "unknown preset '$key' (see: omarchy-typography list)"
  IFS=$'\x1f' read -r id name ui mono status detail <<<"$row"
  [[ $id == stock ]] && { apply_stock; return; }
  [[ $status == unavailable ]] && die "$name is unavailable: $detail"
  [[ $status == substituted ]] && echo "note: $detail" >&2
  apply_pair "$id" "$ui" "$mono"
}

match_preset() { # ui mono -> preset id or custom
  local id
  while read -r id; do
    local row; row=$(resolve_preset "$id")
    IFS=$'\x1f' read -r pid _ pui pmono pst _ <<<"$row"
    [[ $pst == available && $pui == "$1" && $pmono == "$2" ]] && { printf '%s' "$pid"; return; }
  done < <(jq -r '.presets[1:][].id' "$PRESETS")
  printf custom
}

cmd_custom() {
  (( $# == 2 )) || die "usage: omarchy-typography custom <ui-family> <mono-family>"
  apply_pair "$(match_preset "$1" "$2")" "$1" "$2"
}

cmd_role() { # ui|mono family
  local role=$1 fam=${2:-}; [[ -n $fam ]] || die "usage: omarchy-typography $role <family>"
  local ui mono
  ui=$(state_get .ui); mono=$(state_get .mono)
  # From stock, the untouched role keeps the stock terminal font; a UI role must be named.
  [[ -n $mono ]] || mono=$(omarchy-font-current)
  [[ -n $ui ]] || { [[ $role == ui ]] || die "no UI font selected yet; use: omarchy-typography custom <ui> <mono>"; }
  [[ $role == ui ]] && ui=$fam || mono=$fam
  cmd_custom "$ui" "$mono"
}

cmd_reapply() {
  local cur; cur=$(current_preset)
  if [[ $cur == stock ]]; then apply_stock; else apply_pair "$cur" "$(state_get .ui)" "$(state_get .mono)"; fi
}

cmd_hook_font_set() { # called by Omarchy's font-set hook after `omarchy font set <name>`
  local fam=${1:-}; [[ -n $fam && -f $STATE ]] || return 0
  local cur; cur=$(current_preset)
  [[ $cur == stock ]] && return 0             # stock behaves exactly like stock
  [[ $(state_get .mono) == "$fam" ]] && return 0
  local ui; ui=$(state_get .ui)
  write_state "$(match_preset "$ui" "$fam")" "$ui" "$fam"
  apply_gtk "$ui" "$fam"
}

cmd_switcher() { omarchy-shell shell toggle "$PLUGIN_ID" '{}' >/dev/null || die "the switcher needs the Omarchy shell; from a terminal use: omarchy-typography list / set"; }

cmd_import() {
  (( $# )) || die "usage: omarchy-typography import <font-file>... (fonts you hold a licence for)"
  mkdir -p "$FONT_DIR/user"
  local f; for f in "$@"; do
    [[ -f $f ]] || die "no such file: $f"
    case ${f,,} in *.otf|*.ttf|*.ttc|*.otc|*.woff2) ;; *) die "not a font file: $f" ;; esac
    cp -- "$f" "$FONT_DIR/user/"
  done
  fc-cache -f "$FONT_DIR" >/dev/null
  echo "Imported. Families now provided by imported files:"
  fc-list : family file | grep -F "$FONT_DIR/user/" | sed 's/^[^:]*: //' | tr ',' '\n' | sort -u | sed 's/^/  /'
  echo "Run 'omarchy-typography list' to see presets that became available."
}

cmd_substitute() { # preset role family | --clear preset
  if [[ ${1:-} == --clear ]]; then
    [[ -f $SUBS ]] && { jq --arg p "${2:-}" 'del(.[$p])' "$SUBS" >"$SUBS.tmp" && mv "$SUBS.tmp" "$SUBS"; }
    echo "Cleared substitutions for ${2:-}"; return
  fi
  (( $# == 3 )) || die "usage: omarchy-typography substitute <preset-id> <ui|mono> <installed-family>   (or --clear <preset-id>)"
  [[ $2 == ui || $2 == mono ]] || die "role must be ui or mono"
  family_installed "$3" || die "'$3' is not installed"
  jq -e --arg p "$1" '.presets[] | select(.id==$p and .commercial==true)' "$PRESETS" >/dev/null \
    || die "substitutions are only offered for commercial presets"
  mkdir -p "$CFG_DIR"; [[ -f $SUBS ]] || echo '{}' >"$SUBS"
  jq --arg p "$1" --arg r "$2" --arg f "$3" '.[$p][$r] = $f' "$SUBS" >"$SUBS.tmp" && mv "$SUBS.tmp" "$SUBS"
  echo "Substitution recorded: $1 $2 → $3 (shown as a substitute everywhere; clear with: omarchy-typography substitute --clear $1)"
}

cmd_doctor() {
  local ok=1 cur; cur=$(current_preset)
  check() { if eval "$2"; then echo "  ok    $1"; else echo "  FAIL  $1"; ok=0; fi; }
  echo "Typography doctor — preset: $cur"
  check "baseline present"                      "[[ -f $BASELINE/manifest.json ]]"
  check "icon fallback (Symbols Nerd Font)"     "family_installed 'Symbols Nerd Font' && [[ -f '$FC_CONF' ]]"
  check "shell plugin enabled"                  "jq -e '.plugins[]? | select(.id==\"$PLUGIN_ID\")' ~/.config/omarchy/shell.json >/dev/null"
  check "font-set hook installed"               "[[ -f '$HOOK' ]]"
  [[ -d $NOTIFY_CLONE ]] && check "notifications clone matches upstream"  "[[ \$(cat ~/.config/omarchy/plugins/\${USER}.notifications/.omarchy-typography-upstream 2>/dev/null) == \$(cd /usr/share/omarchy/shell/plugins/notifications && find . -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | cut -c1-16) ]]"
  check "global monospace alias is monospaced"  "fc-match monospace -f '%{spacing}' | grep -qE '^(90|100)$'"
  if [[ $cur != stock ]]; then
    local ui mono; ui=$(state_get .ui); mono=$(state_get .mono)
    check "UI font installed ($ui)"             "family_installed \"\$ui\""
    check "mono font installed ($mono)"         "family_installed \"\$mono\""
    check "monospace alias → $mono"             "[[ \"\$(fc-match monospace -f '%{family[0]}')\" == \"\$mono\" ]]"
    check "terminals use $mono"                 "grep -q \"\$mono\" ~/.config/alacritty/alacritty.toml && grep -q \"\$mono\" ~/.config/foot/foot.ini && grep -q \"\$mono\" ~/.config/ghostty/config"
    check "GTK UI font = $ui"                   "gsettings get org.gnome.desktop.interface font-name | grep -qF \"\$ui\""
    check "Hyprland titles = $ui"               "grep -qF \"\$ui\" '$HYPR_FILE'"
  else
    check "no fonts.conf (stock)"               "[[ ! -f '$FONTS_CONF' ]]"
    check "monospace alias is stock"            "[[ \"\$(fc-match monospace -f '%{family[0]}')\" == \"$(stock_mono)\" ]]"
    local base_ui base_mono; base_ui=$(baseline_get '.gsettings["font-name"]'); base_mono=$(baseline_get '.gsettings["monospace-font-name"]')
    check "GTK fonts are baseline"              "[[ \"\$(gsettings get org.gnome.desktop.interface font-name)\" == \"'\$base_ui'\" && \"\$(gsettings get org.gnome.desktop.interface monospace-font-name)\" == \"'\$base_mono'\" ]]"
    check "terminal configs match baseline"     "( for r in alacritty/alacritty.toml foot/foot.ini ghostty/config kitty/kitty.conf; do [[ ! -f $BASELINE/files/.config/\$r ]] || cmp -s ~/.config/\$r $BASELINE/files/.config/\$r || exit 1; done )"
    check "no Hyprland override"                "[[ ! -f '$HYPR_FILE' ]]"
  fi
  (( ok ))
}

cmd_rescue() {
  # For a shell that fails to come back: stock typography, plugin disabled, shell restarted.
  QUIET=1 apply_stock || true
  omarchy-plugin-disable "$PLUGIN_ID" >/dev/null 2>&1 || true
  omarchy-restart-shell || true
  echo "Rescue done: stock typography, $PLUGIN_ID disabled. Re-enable with: omarchy plugin enable $PLUGIN_ID"
}

cmd_files() {
  cat <<EOF
Plugin folder (managed by \`omarchy plugin\`):
  $ROOT
Created by \`omarchy-typography install\`:
  $DATA/                             baseline of every file below that existed, fonttools venv
  $FONT_DIR/                         OFL fonts, Symbols Nerd Font, tabular-figure copies, imports
  $CFG_DIR/                          state.json (your selection), substitutions.json
  $FC_CONF                           icon-glyph fallback
  $HOOK                              keeps the selection in sync with 'omarchy font set'
  $UPDATE_HOOK                       rebuilds the notifications clone after updates (if opted in)
  $BIN_LINK                          CLI link
Edited in marked blocks:
  $HYPR_MAIN                         guarded include of typography.lua
  $MENU_EXT                          Appearance › Typography rows
Only while a preset is active:
  $HYPR_FILE                         window-title font
  gsettings org.gnome.desktop.interface font-name / monospace-font-name
  terminal font lines and ~/.config/fontconfig/fonts.conf (through omarchy-font-set)
Only with 'notifications on':
  $NOTIFY_CLONE/                     upstream notifications clone, 3 font lines patched; built-in disabled
EOF
}

strip_block() { # file — delete the marked block (inclusive)
  [[ -f $1 ]] || return 0
  # Remove the marked block, plus the blank line the installer put before it.
  perl -0pi -e 's/\n\n([^\n]*omarchy-typography >>>.*?<<< omarchy-typography[^\n]*\n)/\n/s or s/^[^\n]*omarchy-typography >>>.*?<<< omarchy-typography[^\n]*\n//ms' "$1"
}

cmd_uninstall() {
  local purge=0; [[ ${1:-} == --purge ]] && purge=1
  [[ -f $BASELINE/manifest.json ]] || die "no baseline at $BASELINE; nothing to restore"
  echo "Restoring stock typography…"
  QUIET=1 apply_stock
  "$ROOT/bin/notifications-sync" --remove >/dev/null 2>&1 || true
  omarchy-plugin-disable "$PLUGIN_ID" >/dev/null 2>&1 || true
  strip_block "$HYPR_MAIN"; strip_block "$MENU_EXT"
  rm -f "$FC_CONF" "$HOOK" "$UPDATE_HOOK" "$HYPR_FILE"
  [[ -L $BIN_LINK ]] && rm -f "$BIN_LINK"
  rmdir "$HOME/.config/fontconfig/conf.d" "$HOME/.config/fontconfig" 2>/dev/null || true
  rm -rf "$CFG_DIR" "$FONT_DIR"
  fc-cache -f >/dev/null 2>&1
  local rel diffs=0
  while read -r rel; do
    local cur="$HOME/.config/$rel" base="$BASELINE/files/.config/$rel"
    [[ -f $base ]] || continue
    if ! cmp -s "$cur" "$base"; then diffs=1; echo "  differs from baseline (edited since install?): ~/.config/$rel"; fi
  done < <(jq -r '.files[]' "$BASELINE/manifest.json")
  (( diffs )) || echo "  every file the installer touched matches the baseline"
  hyprctl reload >/dev/null 2>&1
  omarchy-restart-shell >/dev/null 2>&1 || true
  if (( purge )); then chmod -R u+w "$DATA" 2>/dev/null; rm -rf "$DATA"; echo "  removed $DATA"; fi
  echo "Done. Remove the plugin itself with: omarchy plugin remove $PLUGIN_ID"
}

cmd_notifications() {
  case ${1:-status} in
    on)  "$ROOT/bin/notifications-sync" && omarchy-restart-shell >/dev/null 2>&1; echo "Notification text now follows the UI font." ;;
    off) "$ROOT/bin/notifications-sync" --remove && omarchy-restart-shell >/dev/null 2>&1; echo "Built-in notifications restored." ;;
    status) [[ -d $NOTIFY_CLONE ]] && echo "on (patched clone at $NOTIFY_CLONE)" || echo "off (built-in notifications)" ;;
    *) die "usage: omarchy-typography notifications on|off|status" ;;
  esac
}

usage() {
  cat <<'EOF'
Usage: omarchy-typography <command>

  list [--json]              Presets, availability, active marker (●)
  status                     Active pairing and where each role is applied
  set <preset>               Apply a preset by id or name ("modernist-classic", "Original Omarchy")
  stock                      One-step return to stock Omarchy typography
  custom <ui> <mono>         Apply your own pairing
  ui <family> | mono <family>  Change one role, keep the other
  switcher                   Open the in-shell switcher with live previews and A/B comparison
  families                   Installed proportional and monospace families
  import <files…>            Add font files you are licensed to use (e.g. Futura Now, Avenir Next)
  substitute <preset> <ui|mono> <family>   Explicit, labelled stand-in for a commercial font
  reapply                    Re-apply the saved selection (after `omarchy refresh …`, say)
  doctor                     Verify every surface matches the selection
  rescue                     Shell won't come back? Stock fonts, plugin off, shell restarted
  files                      Everything this tool owns or edits
  install [--yes]            Set up fonts, menu rows and hooks (lists changes and asks first)
  notifications on|off       Opt in to notification text in the UI font (replaces the built-in notifier with a patched clone)
  uninstall [--purge]        Restore the baseline; --purge also deletes the baseline and venv
EOF
}

[[ -f $PRESETS ]] || die "missing $PRESETS"
cmd=${1:-status}; shift || true
case $cmd in
  list) cmd_list "$@" ;;
  status) cmd_status ;;
  set|apply) cmd_set "$@" ;;
  stock|reset|original) apply_stock ;;
  custom) cmd_custom "$@" ;;
  ui|mono) cmd_role "$cmd" "$@" ;;
  families) cmd_families "$@" ;;
  switcher|open) cmd_switcher ;;
  import) cmd_import "$@" ;;
  substitute) cmd_substitute "$@" ;;
  reapply) cmd_reapply ;;
  doctor) cmd_doctor ;;
  rescue) cmd_rescue ;;
  files) cmd_files ;;
  uninstall) cmd_uninstall "$@" ;;
  install) exec "$ROOT/bin/install" "$@" ;;
  notifications) cmd_notifications "$@" ;;
  current) current_preset; echo ;;
  is) [[ $(current_preset) == "${1:-}" ]] ;;
  available) row=$(resolve_preset "${1:-}") || exit 2; [[ $(cut -d$'\x1f' -f5 <<<"$row") != unavailable ]] ;;
  _hook-font-set) cmd_hook_font_set "$@" ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 1 ;;
esac
